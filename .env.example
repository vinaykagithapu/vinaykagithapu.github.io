# ──────────────────────────────────────────────────────────────
# .env.example — sample environment variables for this project
#
# Usage:  cp .env.example .env   then fill in real values.
# `.env` is gitignored — NEVER commit real tokens.
# Load into a shell:  set -a; . ./.env; set +a   (or use direnv)
# ──────────────────────────────────────────────────────────────

# ── GitHub API access ──────────────────────────────────────────
# Used by automation/scripts for PRs and profile updates
# (see .opencode/skills/site-publish and .opencode/skills/profile-sync).
# Create at: https://github.com/settings/tokens (fine-grained: repo + read:user).
GITHUB_TOKEN_NAME=your-token-name
GITHUB_TOKEN=github_pat_replace_me
GITHUB_TOKEN_EXPIRATION=2026-12-31T00:00:00Z

# ── Docusaurus deploy (npm run deploy) ─────────────────────────
# Publishes build/ to the gh-pages branch (see .opencode/skills/site-publish).
# GIT_USER is embedded in a git clone URL → must NOT contain spaces.
GIT_USER=your-github-username
GIT_USER_NAME=Your Full Name
GIT_USER_EMAIL=you@example.com

# Optional alternatives:
# USE_SSH=true          # use SSH remote instead of GIT_USER over HTTPS
# GIT_PASS=             # password/token if the remote requires it
# CUSTOM_COMMIT_MESSAGE=Deploy website   # override default deploy commit message

# ── Optional: silence the Docusaurus update-notifier banner ──
# Not required anymore — the repo is npm-only (yarn.lock removed), so the
# notifier no longer crashes. Set it to keep CLI output clean.
NO_UPDATE_NOTIFIER=1
